# Note: Next.js automatically sets NODE_ENV based on `next dev` (development) or `next build` (production). Do not set NODE_ENV in this file manually.

# Note: Next.js manages its own server port at runtime. Do not add PORT configurations to this file.
# To change the port during local development, use terminal flags instead:
#   pnpm dev --port 4000